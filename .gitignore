# ─────────────────────────────────────────────
#  Root .gitignore — covers frontend/ & backend/
# ─────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
build/
out/
**/dist/
**/build/
**/out/

# Environment variables — ignore all .env* except .example files
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite (frontend)
.vite/
**/.vite/
*.local

# Runtime / process
*.pid
*.pid.lock

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Proto generated (backend)
**/generated/
**/__generated__/

# Coverage & testing
coverage/
.nyc_output/
**/coverage/
**/.nyc_output/

# Storybook (frontend)
storybook-static/

# Docker local overrides (backend)
docker-compose.override.yml
docker-compose.local.yml

# Kubernetes secrets (backend)
*-secret.yaml
secrets/

# Temp
tmp/
temp/

# Local-only docs
docs/
PROJECT_PIPELINE.md
**/PROJECT_PIPELINE.md
