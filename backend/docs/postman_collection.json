    {
      "name": "Service A — Auth",
      "item": [
        {
          "name": "AdminLogin",
          "request": {
            "method": "POST",
            "url": "grpc://{{serviceA}}/servicea.ServiceA/AdminLogin",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Returns JWT with role=ADMIN. Copy token to {{adminToken}}."
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "grpc://{{serviceA}}/servicea.ServiceA/Register",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "grpc://{{serviceA}}/servicea.ServiceA/Login",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"User@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Returns JWT with role=USER. Copy token to {{userToken}}."
          },
          "response": []
        }
      ]
