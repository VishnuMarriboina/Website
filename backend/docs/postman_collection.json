{
  "info": {
    "name": "Microservices gRPC API",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Complete gRPC API collection. Import into Postman and use the gRPC request type.\n\nBase addresses:\n  Service A: localhost:50051\n  Service B: localhost:50052\n\nFor each request, set proto file path to backend/proto/service-a.proto or service-b.proto.\n\nSeed credentials:\n  Admin:  admin@example.com / Admin@123\n  Users:  user1@example.com … user10@example.com / User@1234",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "serviceA", "value": "localhost:50051", "type": "string" },
    { "key": "serviceB", "value": "localhost:50052", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "userToken",  "value": "", "type": "string" },
    { "key": "productId",  "value": "", "type": "string" },
    { "key": "orderId",    "value": "", "type": "string" },
    { "key": "jobId",      "value": "", "type": "string" },
    { "key": "appId",      "value": "", "type": "string" }
  ],
