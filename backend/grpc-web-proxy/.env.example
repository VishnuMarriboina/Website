NODE_ENV=development
PORT=8080

# CORS — set to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# Downstream gRPC service addresses
SERVICE_A_GRPC_HOST=localhost
SERVICE_A_GRPC_PORT=50051

SERVICE_B_GRPC_HOST=localhost
SERVICE_B_GRPC_PORT=50052

# Rate limiting — applies per client IP to Login/Register/AdminLogin/RefreshToken only
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
