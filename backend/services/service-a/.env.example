NODE_ENV=development

# gRPC server port
SERVICE_A_GRPC_PORT=50051

# MySQL (Prisma)
DATABASE_URL=mysql://root:password@localhost:3306/servcrust

# JWT (used for Register/Login auth)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Service B gRPC (for service-to-service calls)
SERVICE_B_GRPC_HOST=localhost
SERVICE_B_GRPC_PORT=50052
