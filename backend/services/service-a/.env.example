NODE_ENV=development

# gRPC server port
SERVICE_A_GRPC_PORT=50051

# MongoDB
MONGODB_URI=mongodb://localhost:27017/myData

# JWT (used for Register/Login auth)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Service B gRPC (for service-to-service calls)
SERVICE_B_GRPC_HOST=localhost
SERVICE_B_GRPC_PORT=50052
