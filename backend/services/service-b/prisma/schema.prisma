generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Job {
  id                 String        @id @default(cuid())
  title              String        @db.VarChar(200)
  description        String        @default("") @db.VarChar(5000)
  department         String        @default("") @db.VarChar(100)
  location           String        @default("") @db.VarChar(200)
  experienceRequired String        @default("") @db.VarChar(100)
  salaryRange        String        @default("") @db.VarChar(100)
  status             String        @default("active") @db.VarChar(50)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  applications       Application[]

  @@index([title])
  @@index([status])
  @@index([department])
  @@map("jobs")
}

model Application {
  id                String   @id @default(cuid())
  userId            String   @db.VarChar(36)
  jobId             String   @db.VarChar(36)
  resumeUrl         String   @default("") @db.VarChar(500)
  coverLetter       String   @default("") @db.VarChar(3000)
  applicationStatus String   @default("pending") @db.VarChar(50)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("applications")
}

model Record {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  content   String   @default("") @db.VarChar(5000)
  status    String   @default("active") @db.VarChar(50)
  refId     String   @default("") @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("records")
}
