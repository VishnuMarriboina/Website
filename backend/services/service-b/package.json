{
  "name": "service-b",
  "version": "1.0.0",
  "description": "Service B — gRPC microservice (Record domain)",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed:jobs": "ts-node src/scripts/seedJobs.ts",
    "seed": "ts-node src/scripts/seed.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "dotenv": "^17.2.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.16.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
