# ============================================================
# ROOT ENVIRONMENT — copy to .env and fill values
# ============================================================

NODE_ENV=development

# MySQL (Prisma) — shared database for both services
DATABASE_URL=mysql://root:password@localhost:3306/servcrust

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Gateway
GATEWAY_PORT=3000

# Service A
SERVICE_A_PORT=3001
SERVICE_A_GRPC_PORT=50051
SERVICE_A_GRPC_HOST=localhost

# Service B
SERVICE_B_PORT=3002
SERVICE_B_GRPC_PORT=50052
SERVICE_B_GRPC_HOST=localhost

# Rate Limiting — consumed by grpc-web-proxy; applies per client IP to
# Login/Register/AdminLogin/RefreshToken only
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Redis (future)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (future)
RABBITMQ_URL=amqp://localhost:5672
